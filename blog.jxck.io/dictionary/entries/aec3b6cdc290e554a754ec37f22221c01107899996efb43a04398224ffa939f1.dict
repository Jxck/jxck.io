    <link rel=stylesheet property=stylesheet type=text/css href=https://www.jxck.io/assets/css/info.css?250125_014517>
    <dl class=info>
      <div><dt>created_at</dt><dd><time class=created_at datetime=2023-12-31>2023-12-31</time></dd></div>
      <div><dt>updated_at</dt><dd><time class=updated_at datetime=2026-07-04>2026-07-04</time></dd></div>
